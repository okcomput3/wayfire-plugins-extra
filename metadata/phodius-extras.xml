<?xml version="1.0"?>
<wayfire>
	<plugin name="phodius-extras">
		<_short>Phodius Extras</_short>
		<_long>Extra animations to extend animate plugin</_long>
		<category>Effects</category>
		<group>
			<_short>Mercury Settings</_short>
			<option name="mercury_duration" type="animation">
				<_short>Mercury duration</_short>
				<_long>Sets the duration for the mercury animation in milliseconds.</_long>
				<default>1000ms linear</default>
			</option>
			<option name="mercury_flame_speed" type="double">
				<_short>Mercury speed</_short>
				<_long>The speed at which the mercury runs at.</_long>
				<default>7</default>
				<min>1</min>
				<max>100</max>
				<precision>1</precision>
			</option>
			<option name="mercury_flame_width" type="double">
				<_short>Mercury width</_short>
				<_long>The width of the flames.</_long>
				<default>0.7</default>
				<min>0.01</min>
				<max>1.0</max>
				<precision>0.01</precision>
			</option>
			<option name="mercury_flame_height" type="double">
				<_short>Mercur height</_short>
				<_long>The height of the flames.</_long>
				<default>0.7</default>
				<min>0.01</min>
				<max>1.0</max>
				<precision>0.01</precision>
			</option>
			<option name="mercury_flame_color" type="color">
				<_short>Mercury Color</_short>
				<_long>Color used for rendering the mercury.</_long>
				<default>0.00 0.00 0.00 1.00</default>
			</option>
		</group>
		<group>
			<_short>Dali Settings</_short>
			<option name="dali_duration" type="animation">
				<_short>Dali duration</_short>
				<_long>Sets the duration for the dali animation in milliseconds.</_long>
				<default>1000ms linear</default>
			</option>
			<option name="dali_flame_speed" type="double">
				<_short>Dali speed</_short>
				<_long>The speed at which the dali effect runs at</_long>
				<default>7</default>
				<min>1</min>
				<max>100</max>
				<precision>1</precision>
			</option>
			<option name="dali_flame_width" type="double">
				<_short>Dali width</_short>
				<_long>The width of the distortion.</_long>
				<default>0.7</default>
				<min>0.01</min>
				<max>1.0</max>
				<precision>0.01</precision>
			</option>
			<option name="dali_flame_height" type="double">
				<_short>Dali height</_short>
				<_long>The height of the distortion.</_long>
				<default>0.7</default>
				<min>0.01</min>
				<max>1.0</max>
				<precision>0.01</precision>
			</option>
			<option name="dali_flame_color" type="color">
				<_short>Dali Color</_short>
				<_long>Color used for rendering the tint.</_long>
				<default>1.00 1.00 1.00 1.00</default>
			</option>
		</group>
	</plugin>
</wayfire>
